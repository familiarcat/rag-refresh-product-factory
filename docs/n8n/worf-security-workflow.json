{
  "name": "Lt. Worf - Security Automation",
  "nodes": [
    {
      "parameters": {
        "path": "worf/security-check",
        "method": "POST",
        "responseMode": "responseNode",
        "options": {}
      },
      "name": "Webhook - Security Check Trigger",
      "type": "n8n-nodes-base.webhook",
      "position": [250, 300],
      "webhookId": "worf-security-check"
    },
    {
      "parameters": {
        "url": "={{$env.ALEX_AI_URL}}/api/crew/worf?action=status",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "alexAiApi",
        "options": {}
      },
      "name": "Get Security Status",
      "type": "n8n-nodes-base.httpRequest",
      "position": [450, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.analysis.overall}}",
              "operation": "equals",
              "value2": "critical"
            }
          ]
        }
      },
      "name": "Is Critical?",
      "type": "n8n-nodes-base.if",
      "position": [650, 300]
    },
    {
      "parameters": {
        "url": "={{$env.ALEX_AI_URL}}/api/crew/worf",
        "method": "POST",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "alexAiApi",
        "bodyParameters": {
          "parameters": [
            {
              "name": "operation",
              "value": "request_crew_assistance"
            },
            {
              "name": "params",
              "value": "={{ {task: 'security_critical_review', urgency: 'high'} }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Request Crew Assistance",
      "type": "n8n-nodes-base.httpRequest",
      "position": [850, 200]
    },
    {
      "parameters": {
        "url": "={{$env.ALEX_AI_URL}}/api/crew/worf",
        "method": "POST",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "alexAiApi",
        "bodyParameters": {
          "parameters": [
            {
              "name": "operation",
              "value": "analyze_security"
            }
          ]
        },
        "options": {}
      },
      "name": "Run Security Analysis",
      "type": "n8n-nodes-base.httpRequest",
      "position": [850, 400]
    },
    {
      "parameters": {
        "respondWith": "={{$json.agent}} security check complete",
        "responseBody": "={{ $json }}",
        "options": {}
      },
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "position": [1050, 300]
    }
  ],
  "connections": {
    "Webhook - Security Check Trigger": {
      "main": [[{"node": "Get Security Status", "type": "main", "index": 0}]]
    },
    "Get Security Status": {
      "main": [[{"node": "Is Critical?", "type": "main", "index": 0}]]
    },
    "Is Critical?": {
      "main": [
        [{"node": "Request Crew Assistance", "type": "main", "index": 0}],
        [{"node": "Run Security Analysis", "type": "main", "index": 0}]
      ]
    },
    "Request Crew Assistance": {
      "main": [[{"node": "Respond to Webhook", "type": "main", "index": 0}]]
    },
    "Run Security Analysis": {
      "main": [[{"node": "Respond to Webhook", "type": "main", "index": 0}]]
    }
  }
}

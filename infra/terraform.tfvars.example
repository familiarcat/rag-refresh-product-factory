# AWS Region
aws_region = "us-east-1"

# EC2 Key Pair (must exist in AWS)
key_name = "your-ec2-keypair"

# Instance configuration
instance_type  = "t3.small"
root_volume_gb = 40

# Security (replace with your IP for SSH access)
allowed_ssh_cidrs = ["YOUR_IP/32"]

# Resource naming
name = "rag-refresh-product-factory"

# === TLS/Domain Configuration ===
# Set to false for quick deploy without domain/SSL
enable_alb_tls = true

# Your domain (must have Route53 hosted zone)
domain_name     = "yourdomain.com"
route53_zone_id = "Z0123456789ABCDEFGHIJ"

# Subdomains for app and n8n
app_subdomain = "app"
n8n_subdomain = "n8n"


import * as vscode from "vscode";
import * as fs from "fs";
import { join } from "path";
import { AlexAiClient, SprintStatus } from "./client";
import { AlexFileSystemService } from "./alexFileSystem";

interface WorkspaceAnalysis {
  files: {
    path: string;
    content: string;
    lastModified: Date;
    type: string;
  }[];
  structure: {
    root: string;
    directories: string[];
    dependencies: {
      package: Record<string, any>;
      typescript: Record<string, any>;
    };
  };
  context: {
    languageIds: Set<string>;
    projectType: string;
    mainEntryPoints: string[];
  };
}

export class AlexAiService {
  private workspaceAnalysis: WorkspaceAnalysis | null = null;
  private client: AlexAiClient;
  private config: any;
  fileSystem: AlexFileSystemService | undefined;

  constructor() {
    this.client = new AlexAiClient();
  }

  async analyzeWorkspace(): Promise<WorkspaceAnalysis> {
    if (this.workspaceAnalysis) return this.workspaceAnalysis;

    const analysis: WorkspaceAnalysis = {
      files: [],
      structure: {
        root: "",
        directories: [],
        dependencies: { package: {}, typescript: {} },
      },
      context: {
        languageIds: new Set(),
        projectType: "",
        mainEntryPoints: [],
      },
    };

    if (vscode.workspace.workspaceFolders) {
      const workspaceRoot = vscode.workspace.workspaceFolders[0].uri.fsPath;
      analysis.structure.root = workspaceRoot;

      const files = await vscode.workspace.findFiles("**/*", "**/node_modules/**");
      for (const file of files) {
        try {
          const content = await vscode.workspace.fs.readFile(file);
          const stat = await vscode.workspace.fs.stat(file);
          const text = Buffer.from(content).toString("utf8");
          analysis.files.push({
            path: file.fsPath,
            content: text,
            lastModified: new Date(stat.mtime),
            type: file.fsPath.split(".").pop() || "",
          });
          const doc = await vscode.workspace.openTextDocument(file);
          analysis.context.languageIds.add(doc.languageId);
        } catch {
          // ignore unreadable files
        }
      }

      const packageJson = analysis.files.find((f) => f.path.endsWith("package.json"));
      if (packageJson) analysis.structure.dependencies.package = JSON.parse(packageJson.content);
      const tsconfig = analysis.files.find((f) => f.path.endsWith("tsconfig.json"));
      if (tsconfig) analysis.structure.dependencies.typescript = JSON.parse(tsconfig.content);

      analysis.context.projectType = this.determineProjectType(analysis);
      analysis.context.mainEntryPoints = this.findEntryPoints(analysis);
    }

    this.workspaceAnalysis = analysis;
    return analysis;
  }

  private determineProjectType(analysis: WorkspaceAnalysis): string {
    const files = analysis.files.map((f) => f.path);
    if (files.some((f) => f.includes("vscode"))) return "vscode-extension";
    if (files.some((f) => f.includes("angular.json"))) return "angular";
    if (files.some((f) => f.includes("next.config"))) return "next.js";
    return "unknown";
  }

  private findEntryPoints(analysis: WorkspaceAnalysis): string[] {
    return analysis.files
      .filter((f) => f.path.includes("main.ts") || f.path.includes("index.ts"))
      .map((f) => f.path);
  }

  // Chat: delegate to AlexAiClient and return a string (consistent with callers)
  async chat(crewMember: string, prompt: string, fileContext?: string): Promise<string> {
    return await this.client.chat(crewMember, prompt, fileContext);
  }

  async getSprintStatus(): Promise<SprintStatus | null> {
    return await this.client.getSprintStatus();
  }

  async getMemories(crewMember?: string): Promise<string[]> {
    return await this.client.getMemories(crewMember);
  }

  async conveneObservationLounge(topic: string) {
    return await this.client.conveneObservationLounge(topic);
  }

  // File system manager accessor
  getFileSystemManager(): AlexFileSystemService | undefined {
    return this.fileSystem;
  }

  // Recommendation & Plan persistence helpers (simple file-backed)
  private ensureDataDir(): string {
    const root = vscode.workspace.workspaceFolders?.[0].uri.fsPath || process.cwd();
    const dataDir = join(root, "data", "alex-ai");
    try {
      fs.mkdirSync(dataDir, { recursive: true });
    } catch {}
    return dataDir;
  }

  async saveRecommendation(crewMember: string, payload: any): Promise<string> {
    const dataDir = this.ensureDataDir();
    const filename = `rec_${Date.now()}.json`;
    const full = join(dataDir, filename);
    const record = {
      filename,
      data: { crewMember, ...payload, timestamp: Date.now() },
    };
    await fs.promises.writeFile(full, JSON.stringify(record, null, 2), "utf8");
    return filename;
  }

  async savePlan(plan: any): Promise<string> {
    const dataDir = this.ensureDataDir();
    const filename = `plan_${plan.id || Date.now()}.json`;
    const full = join(dataDir, filename);
    const record = { filename, data: { ...plan, timestamp: Date.now() } };
    await fs.promises.writeFile(full, JSON.stringify(record, null, 2), "utf8");
    return filename;
  }

  async getRecentRecommendations(limit = 10): Promise<any[]> {
    const dataDir = this.ensureDataDir();
    try {
      const files = (await fs.promises.readdir(dataDir)).filter((f) => f.startsWith("rec_")).slice(-limit);
      const out: any[] = [];
      for (const f of files) {
        const content = await fs.promises.readFile(join(dataDir, f), "utf8");
        const parsed = JSON.parse(content);
        out.push(parsed);
      }
      return out.reverse();
    } catch {
      return [];
    }
  }

  async getRecentPlans(limit = 10): Promise<any[]> {
    const dataDir = this.ensureDataDir();
    try {
      const files = (await fs.promises.readdir(dataDir)).filter((f) => f.startsWith("plan_")).slice(-limit);
      const out: any[] = [];
      for (const f of files) {
        const content = await fs.promises.readFile(join(dataDir, f), "utf8");
        const parsed = JSON.parse(content);
        out.push(parsed);
      }
      return out.reverse();
    } catch {
      return [];
    }
  }

  // Execute a code recommendation by replacing oldCode with newCode in the given file path
  async executeCodeRecommendation(filePath: string, oldCode: string, newCode: string): Promise<boolean> {
    try {
      const workspaceRoot = vscode.workspace.workspaceFolders?.[0].uri.fsPath || process.cwd();
      const abs = filePath.startsWith("/") ? filePath : join(workspaceRoot, filePath);
      const content = await fs.promises.readFile(abs, "utf8");
      if (!content.includes(oldCode)) return false;
      const updated = content.replace(oldCode, newCode);
      await fs.promises.writeFile(abs, updated, "utf8");
      return true;
    } catch (e) {
      return false;
    }
  }
}

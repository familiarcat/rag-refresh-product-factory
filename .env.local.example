# Copy to .env.local and replace values (KEY=value)
# OR use: npm run script:secrets:sync to auto-sync from ~/.zshrc

# N8N Webhooks
N8N_WEBHOOK_URL=https://YOUR_N8N_WEBHOOK/sync
N8N_PROJECT_WEBHOOK_URL=https://YOUR_N8N_WEBHOOK/create-project

# Supabase (RBAC Database)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# ECR/EC2 deploy config (used by scripts)
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
ECR_REPO=rag-refresh-product-factory

# EC2 target for GitHub Actions SSH deploy
EC2_HOST=your-ec2-host-or-ip
EC2_USER=ec2-user

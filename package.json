{
  "name": "rag-refresh-product-factory",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "check:env": "node scripts/check-env.mjs",
    "dev:check": "npm run -s check:env && next dev",
    "doctor": "bash scripts/bootstrap/doctor.sh",
    "bootstrap:init": "bash scripts/bootstrap/init_repo.sh",
    "bootstrap:setup": "bash scripts/bootstrap/unify_setup.sh",
    "infra:init": "cd infra && terraform init",
    "infra:plan": "cd infra && terraform plan",
    "infra:apply": "cd infra && terraform apply",
    "secrets:sync": "bash scripts/secrets/sync_from_zshrc.sh && cp .secrets/.env.local .env.local",
    "script:secrets:sync": "npm run -s secrets:sync",
    "scripts:check": "node scripts/maintenance/check-package-scripts.mjs",
    "secrets:gh": "bash scripts/secrets/gh_sync_secrets.sh",
    "script:secrets:ensure": "npx -y tsx scripts/ts/secrets/ensure-env.ts",
    "milestone": "bash scripts/milestone/run_milestone.sh",
    "milestone:prune": "node scripts/milestone/prune_local.mjs",
    "alexai:git:sanitize": "bash scripts/maintenance/git-sanitize.sh",
    "alexai:upgrade": "bash scripts/maintenance/upgrade-and-verify.sh ./rag-refresh-product-factory_enhancements_patch.zip",
    "alexai:utf8:fix": "bash scripts/maintenance/fix-utf8-base64-and-verify.sh --apply",
    "alexai:import": "node scripts/alex-ai/import_project_from_zip.mjs",
    "alexai:memory": "node scripts/alex-ai/create_and_ingest_memory.mjs",
    "alexai:upgrade+ingest": "bash scripts/alex-ai/upgrade_and_ingest.sh --enhancements ./rag-refresh-product-factory_enhancements_patch.zip --orchestrator ./rag-refresh-product-factory_orchestrator_patch.zip --pm-root ./projects",
    "alexai:ts:heal": "bash scripts/maintenance/fix-ts-known-issues.sh && bash scripts/maintenance/fix-ts-sprint-planning-memories.sh && bash scripts/maintenance/ts-heal-supabase-inserts.sh && bash scripts/maintenance/ts-heal-run-build-with-timeout.sh 900 15",
    "milestone:run": "npm run -s secrets:sync && npm run -s check:env && npm run -s milestone",
    "alexai:milestone": "npm run -s milestone:run",
    "alexai:ship:prep": "npm run -s alexai:git:sanitize && npm run -s scripts:check && npm run -s check:env",
    "alexai:ship:milestone": "npm run -s alexai:ship:prep && npm run -s milestone:run",
    "alexai:ship:heal": "npm run -s alexai:ship:prep && npm run -s alexai:ts:heal",
    "alexai:ship:all": "npm run -s alexai:ship:prep && npm run -s alexai:utf8:fix && npm run -s alexai:ts:heal && npm run -s milestone:run",
    "alexai:ship:push": "npm run -s alexai:ship:all && git add -A && (git commit -m \"chore: milestone + docs + build heal\" || true) && git push"
  },
  "dependencies": {
    "@aws-sdk/client-ssm": "^3.952.0",
    "@supabase/supabase-js": "^2.89.0",
    "cytoscape": "^3.30.0",
    "cytoscape-dagre": "^2.5.0",
    "dagre": "^0.8.5",
    "marked": "12.0.2",
    "mermaid": "^11.0.0",
    "next": "^16.0.10",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "reactflow": "^11.11.4"
  },
  "devDependencies": {
    "@types/node": "25.0.2",
    "@types/react": "19.2.7",
    "typescript": "5.9.3"
  }
}

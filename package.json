{
  "name": "rag-refresh-product-factory",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "check:env": "node scripts/check-env.mjs",
    "dev:check": "npm run check:env && next dev",
    "alex-ai:activate": "node scripts/alex-ai/activate.mjs",
    "alex-ai:memories": "node scripts/alex-ai/memories.mjs",
    "alex-ai:coordinate": "node scripts/alex-ai/coordinate.mjs",
    "milestone": "bash scripts/milestone/run_milestone.sh",
    "milestone:deploy": "bash -c 'scripts/milestone/run_milestone.sh \"$1\" --deploy' --",
    "milestone:prune": "node scripts/milestone/prune_local.mjs",
    "deploy": "gh workflow run deploy.yml && echo '\u2705 Deploy triggered! Monitor: gh run list --workflow=deploy.yml --limit 1'",
    "deploy:local": "echo '\u26a0\ufe0f  Local deploy is for emergencies only. Use npm run deploy for CI/CD.' && bash scripts/deploy-app.sh",
    "deploy:orchestration": "bash scripts/deploy-with-orchestration.sh",
    "secrets:sync": "bash scripts/secrets/sync_from_zshrc.sh && cp .secrets/.env.local .env.local",
    "secrets:gh": "bash scripts/secrets/gh_sync_secrets.sh",
    "doctor": "bash scripts/bootstrap/doctor.sh",
    "bootstrap:init": "bash scripts/bootstrap/init_repo.sh",
    "bootstrap:setup": "bash scripts/bootstrap/unify_setup.sh",
    "infra:init": "cd infra && terraform init",
    "infra:apply": "cd infra && terraform apply",
    "infra:plan": "cd infra && terraform plan",
    "crew:chat": "node scripts/cli/crew-chat.mjs",
    "crew:lounge": "node scripts/cli/observation-lounge.mjs",
    "sprint:status": "node scripts/cli/sprint-status.mjs",
    "sprint:start": "node scripts/cli/sprint-start.mjs",
    "sprint:cycle": "node scripts/cli/sprint-cycle.mjs",
    "sprint:run": "node scripts/cli/sprint-run.mjs",
    "vscode:install": "bash scripts/install-vscode-extension.sh",
    "vscode:build": "cd vscode-extension && npm install && npm run compile && npm run package",
    "vscode:dev": "bash scripts/vscode-extension/dev.sh full",
    "vscode:quick": "bash scripts/vscode-extension/dev.sh quick",
    "vscode:test": "bash scripts/vscode-extension/dev.sh test",
    "vscode:watch": "bash scripts/vscode-extension/dev.sh watch",
    "vscode:clean": "bash scripts/vscode-extension/dev.sh clean",
    "vscode:audit": "bash scripts/vscode-extension/security-audit.sh",
    "script:secrets:sync": "tsx scripts/ts/secrets/sync-from-shell.ts",
    "script:secrets:ensure": "tsx scripts/ts/secrets/ensure-env.ts",
    "check:no-python-creep": "tsx scripts/ts/guards/no-python-creep.ts",
    "report:python-inventory": "tsx scripts/ts/guards/python-inventory.ts",
    "check": "pnpm -s check:no-python-creep"
  },
  "dependencies": {
    "@aws-sdk/client-ssm": "^3.952.0",
    "@types/fs-extra": "^11.0.4",
    "chokidar": "^5.0.0",
    "fs-extra": "^11.3.3",
    "marked": "12.0.2",
    "next": "^16.0.10",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.2",
    "@types/react": "19.2.7",
    "typescript": "^5.9.3",
    "tsx": "^4.19.2",
    "dotenv": "^16.4.5"
  }
}
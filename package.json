    "script:secrets:sync": "npm run -s secrets:sync"
  },
  "dependencies": {
    "@aws-sdk/client-ssm": "^3.952.0",
    "@supabase/supabase-js": "^2.89.0",
    "cytoscape": "^3.30.0",
    "cytoscape-dagre": "^2.5.0",
    "dagre": "^0.8.5",
    "marked": "12.0.2",
    "mermaid": "^11.0.0",
    "next": "^16.0.10",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "reactflow": "^11.11.4"
  },
  "devDependencies": {
    "@types/node": "25.0.2",
    "@types/react": "19.2.7",
    "typescript": "5.9.3",
    "dotenv": "^16.4.5"
  }
}

{
  "name": "rag-refresh-product-factory",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bash scripts/worf/worf.sh dev && next dev",
    "build": "npm run test && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "pytest",
    "deploy": "bash scripts/deploy.sh",
    "milestone": "bash scripts/milestone/run_milestone.sh",
